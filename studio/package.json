{
  "name": "barca-yt-studio",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:media": "python3 -m unittest discover -s ../tools/video/tests -v",
    "qc:frames": "node ../tools/video/qc_frames.mjs",
    "render:source": "remotion render src/index.ts CLASICO-SOURCE-SHORT out/CLASICO-SOURCE-SHORT.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709 --image-format=png --concurrency=2 --crf=18 --audio-codec=aac --audio-bitrate=192k"
  },
  "dependencies": {
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "4.0.535",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/layout-utils": "4.0.535",
    "@remotion/transitions": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
